BOT_TOKEN=your_telegram_bot_token

ROBINHOOD_API_KEY=rh-api-your-key
ROBINHOOD_PRIVATE_KEY_BASE64=your_base64_private_key

# true = real Robinhood data, simulated orders
# false = real Robinhood data and live order placement
PAPER_MODE=true

# API v1 is the simpler starting point.
ROBINHOOD_API_VERSION=v1
